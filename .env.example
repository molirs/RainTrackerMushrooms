# Copia este archivo a .env y rellena las claves. .env nunca se sube al repo.

# AEMET OpenData: https://opendata.aemet.es/centrodedescargas/altaUsuario
AEMET_API_KEY=

# Meteocat API REST (opcional: sin clave se usan las Dades Obertes de la Generalitat)
METEOCAT_API_KEY=

# SiAR (MAPA): alta en https://servicio.mapa.gob.es/siarweb/ marcando "Deseo darme de alta en API SiAR".
# Vale el token directamente o usuario (NIF) + contraseña para pedirlo.
SIAR_TOKEN=
SIAR_USER=
SIAR_PASSWORD=

# SAIH Ebro (CHE): cuenta en https://www.saihebro.com/usuarios/registro — límite 100 peticiones/día
SAIH_API_KEY=
